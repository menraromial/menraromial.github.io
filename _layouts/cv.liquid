---
layout: default
---
{% assign basics = site.data.resume.basics %}

<section class="doc-head">
  <div class="eyebrow">§ 5 &middot; Curriculum Vit&aelig;</div>
  <h1>{{ basics.name }}</h1>
  <div class="authors">{{ basics.label }}</div>
  <div class="affil">IMT ATLANTIQUE &middot; INRIA STACK &middot; NANTES, FRANCE</div>
  <div class="date-line">
    <a href="mailto:{{ basics.email }}">{{ basics.email }}</a>
    {% if basics.url %} &middot; <a href="{{ basics.url }}">{{ basics.url }}</a>{% endif %}
  </div>
</section>

<div class="dl-bar">
  <span>Last compiled &mdash; {{ site.time | date: '%-d %b. %Y' }}</span>
  <span>
    {% if page.cv_pdf %}
      <a href="{{ page.cv_pdf | prepend: 'assets/pdf/' | relative_url }}">Download PDF</a> &middot;
    {% endif %}
    <a href="{{ '/publications/' | relative_url }}">Publications page</a>
  </span>
</div>

{% for data in site.data.resume %}
  {% if site.jsonresume and site.jsonresume.size > 0 %}
    {% unless site.jsonresume contains data[0] %}{% continue %}{% endunless %}
  {% endif %}
  {% if data[0] == 'meta' or data[0] == 'basics' %}{% continue %}{% endif %}
  {% assign section_size = data[1] | size %}
  {% if section_size == 0 %}{% continue %}{% endif %}

  {% case data[0] %}
    {% when 'education' %}
      <div class="section-label">Education</div>
      {% include resume/education.liquid %}
    {% when 'work' %}
      <div class="section-label">Work Experience</div>
      {% include resume/work.liquid %}
    {% when 'teaching' %}
      <div class="section-label">Teaching</div>
      {% include resume/teaching.liquid %}
    {% when 'supervision' %}
      <div class="section-label">Student Supervision</div>
      {% include resume/supervision.liquid %}
    {% when 'awards' %}
      <div class="section-label">Awards &amp; Grants</div>
      {% include resume/awards.liquid %}
    {% when 'publications' %}
      <div class="section-label">Publications</div>
      {% include resume/publications.liquid %}
    {% when 'projects' %}
      <div class="section-label">Selected Projects</div>
      {% include resume/projects.liquid %}
    {% when 'volunteer' %}
      <div class="section-label">Service &amp; Volunteering</div>
      {% include resume/volunteer.liquid %}
    {% when 'certificates' %}
      <div class="section-label">Certificates</div>
      {% include resume/certificates.liquid %}
    {% when 'skills' %}
      <div class="section-label">Skills &amp; Tooling</div>
      {% include resume/skills.liquid %}
    {% when 'languages' %}
      <div class="section-label">Languages</div>
      {% include resume/languages.liquid %}
    {% when 'interests' %}
      <div class="section-label">Interests</div>
      {% include resume/interests.liquid %}
    {% when 'references' %}
      <div class="section-label">References</div>
      {% include resume/references.liquid %}
  {% endcase %}
{% endfor %}
