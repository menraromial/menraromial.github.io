---
layout: default
---
{% if page._styles %}
<style type="text/css">{{ page._styles }}</style>
{% endif %}

<section class="doc-head">
  <div class="eyebrow">
    {% if page.categories.size > 0 %}{{ page.categories | first | upcase }} &middot; {% endif %}Notes From the Laboratory
  </div>
  <h1>{{ page.title }}</h1>
  <div class="authors">{{ site.first_name }} {{ site.middle_name }} {{ site.last_name }}</div>
  {% if page.affiliation %}<div class="affil">{{ page.affiliation }}</div>{% endif %}
  <div class="date-line">
    {{ page.date | date: '%-d %b. %Y' }}
    {% assign words = content | number_of_words %}
    {% assign mins = words | divided_by: 200 | plus: 1 %}
    &middot; {{ mins }} min read
    {% if page.tags.size > 0 %}&middot; {% for tag in page.tags %}{{ tag }}{% unless forloop.last %}, {% endunless %}{% endfor %}{% endif %}
  </div>
</section>

{% if page.abstract %}
<section class="abstract" style="max-width:720px">
  <div class="label">Abstract</div>
  <p>{{ page.abstract }}</p>
</section>
{% elsif page.description %}
<section class="abstract" style="max-width:720px">
  <div class="label">Synopsis</div>
  <p>{{ page.description }}</p>
</section>
{% endif %}

<div class="post-grid">

  <!-- Article body -->
  <article class="prose dropcap has-sidenotes" id="article-prose">
    {{ content }}
  </article>

  <!-- Margin notes -->
  <aside class="margin">
    <p>
      <b>Author.</b><br/>
      {{ site.first_name }} {{ site.middle_name }} {{ site.last_name }}<br/>
      <span style="font-style:normal;font-size:11px;">IMT Atlantique &middot; Inria Stack</span>
    </p>
    <hr/>
    <p><b>Published.</b><br/>{{ page.date | date: '%-d %B %Y' }}</p>
    <hr/>
    {% if page.tags.size > 0 %}
    <p>
      <b>Tags.</b><br/>
      <span style="font-style:normal;">{% for tag in page.tags %}{{ tag }}{% unless forloop.last %}, {% endunless %}{% endfor %}</span>
    </p>
    <hr/>
    {% endif %}
    <p>
      <b>Corrections.</b>
      Found an error? Email:
      <a href="mailto:itsme@menraromial.com" style="font-style:normal;font-size:11px;font-family:var(--mono)">itsme@menraromial.com</a>.
    </p>
    <hr/>
    <p>
      <b>Cite as.</b><br/>
      <span style="font-style:normal;font-family:var(--mono);font-size:10.5px">{{ site.last_name }}, {{ site.first_name | slice: 0 }}. {{ site.middle_name | slice: 0 }}. ({{ page.date | date: '%Y' }}). <i>{{ page.title }}</i>. menraromial.com/blog.</span>
    </p>
  </aside>

</div>

{% if page.related_publications %}
<div class="section-label">References</div>
<div>{% bibliography --group_by none --cited_in_order %}</div>
{% endif %}

{% if site.related_blog_posts and site.related_blog_posts.enabled %}
  {% if page.related_posts == null or page.related_posts %}
    {% include related_posts.liquid %}
  {% endif %}
{% endif %}

{% if site.giscus and page.giscus_comments %}
  {% include giscus.liquid %}
{% endif %}
