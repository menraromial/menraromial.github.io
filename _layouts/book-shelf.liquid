---
layout: default
---
<section class="doc-head">
  <div class="eyebrow">§ 0.5 &middot; Bibliotheca Personalis</div>
  <h1>Bookshelf</h1>
  <div class="authors">
    {% assign written_count = site.books | size %}
    {% assign read_count = site.data.books_read | size %}
    {{ written_count }} written &middot; {{ read_count }} read &middot; {{ site.data.books_wishlist | size }} queued
  </div>
  <div class="date-line">Updated {{ site.time | date: '%B %Y' }}</div>
</section>

<div class="epigraph">
  &ldquo;And these words which I command you today shall be in your heart.
  You shall teach them diligently to your children.&rdquo;
  <span class="ref">&mdash; Deuteronomy 6:6-7</span>
</div>

{% if site.books and site.books.size > 0 %}
<div class="section-label">Written &middot; Authored works</div>
<div class="shelf shelf--written">
  {% for book in site.books %}
    <a class="book-authored" href="{{ book.url | relative_url }}">
      <div class="cover-authored">
        {% if book.cover %}
          <img src="{{ book.cover | relative_url }}" alt="{{ book.title }}" />
        {% else %}
          <div class="cover-authored__inner c-ink">
            {% if book.released %}<div class="pub">{{ book.released }}</div>{% endif %}
            <div>
              <div class="t">{{ book.title }}</div>
              {% if book.author %}<div class="a">{{ book.author }}</div>{% endif %}
            </div>
            <div class="pub">{{ book.status | default: 'Available' }}</div>
          </div>
        {% endif %}
      </div>
      <div class="meta">
        <span class="bt">{{ book.title }}</span>
        {% if book.author %}<span class="ba">{{ book.author }}</span>{% endif %}
        {% if book.released %}
        <span class="mono" style="font-size:10.5px;letter-spacing:0.1em;text-transform:uppercase;color:var(--ink-3)">
          {{ book.released }}{% if book.status %} &middot; {{ book.status }}{% endif %}
        </span>
        {% endif %}
      </div>
    </a>
  {% endfor %}
</div>
{% endif %}

{% if site.data.books_read and site.data.books_read.size > 0 %}
<div class="section-label">Read &middot; Personal library</div>
<div class="shelf">
  {% for book in site.data.books_read %}
    <div class="book {{ book.color }}">
      <div class="cover">
        <div class="pub">{{ book.year }}</div>
        <div>
          <div class="t">{{ book.title }}</div>
          <div class="a">{{ book.author }}</div>
        </div>
        <div class="pub">Read</div>
      </div>
      <div class="meta">
        <span class="bt">{{ book.title }}</span>
        <span class="ba">{{ book.author }}</span>
      </div>
      <div class="rating mono" style="font-size:10.5px;letter-spacing:0.1em;text-transform:uppercase;color:var(--ink-3)">
        {{ book.year }}
      </div>
    </div>
  {% endfor %}
</div>
{% endif %}

{% if site.data.books_wishlist and site.data.books_wishlist.size > 0 %}
<div class="section-label">Wishlist &middot; Queued</div>
<table class="index">
  <tbody>
    {% for book in site.data.books_wishlist %}
    <tr>
      <td class="date">pending</td>
      <td><i>{{ book.title }}</i> &mdash; {{ book.author }}{% if book.note %}. {{ book.note }}{% endif %}</td>
    </tr>
    {% endfor %}
  </tbody>
</table>
{% endif %}

{{ content }}

<p class="small muted" style="margin-top:32px">
  This shelf gathers both authored works and personal reads.
  Full notes and course materials available on request &mdash; send an email.
</p>
