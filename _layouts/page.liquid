---
layout: default
---
{% if page._styles %}
<style type="text/css">{{ page._styles }}</style>
{% endif %}

<section class="doc-head">
  <div class="eyebrow">{{ page.nav_order | default: '§' }} &middot; {{ page.title | upcase }}</div>
  <h1>{{ page.title | capitalize }}</h1>
  {% if page.description %}<div class="date-line">{{ page.description }}</div>{% endif %}
</section>

<article class="prose">
  {{ content }}
</article>

{% if page.related_publications %}
<div class="section-label">References</div>
<div>{% bibliography --cited_in_order %}</div>
{% endif %}

{% if site.giscus and page.giscus_comments %}
  {% include giscus.liquid %}
{% endif %}
