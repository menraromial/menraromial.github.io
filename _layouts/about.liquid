---
layout: default
---
<section class="doc-head">
  <div class="eyebrow">Research Statement &middot; Energy-Aware Cloud Computing</div>
  <h1>Making Clouds Leaner</h1>
  <div class="authors">{{ site.first_name }} {{ site.middle_name }} {{ site.last_name }}</div>
  <div class="affil">IMT ATLANTIQUE &middot; INRIA &middot; STACK TEAM &middot; NANTES, FR</div>
  
</section>

{% if page.abstract %}
<section class="abstract">
  <div class="label">Abstract</div>
  <p>{{ page.abstract }}</p>
  {% if page.abstract_keywords %}
  <div class="keywords"><b>Keywords &middot;</b> {{ page.abstract_keywords }}</div>
  {% endif %}
</section>
{% endif %}

{% if page.profile %}
<div class="about-profile-grid">
  <figure class="fig about-profile-fig">
    {% if page.profile.image %}
      {% assign profile_image_path = page.profile.image | prepend: 'assets/img/' %}
      <img src="{{ profile_image_path | relative_url }}" alt="{{ site.first_name }} {{ site.last_name }}" loading="eager" />
    {% endif %}
    <figcaption><b>Fig. 1.</b> The author, mid&#8209;argument with a scheduler.</figcaption>
  </figure>

  <div class="prose has-sidenotes">
    <div class="section-label">1 &middot; Motivation</div>
    {{ content }}
  </div>
</div>
{% else %}
<div class="prose has-sidenotes">
  <div class="section-label">1 &middot; Motivation</div>
  {{ content }}
</div>
{% endif %}

<hr class="rule" />

{% if page.announcements and page.announcements.enabled %}
<div class="section-label">2 &middot; News &amp; Recent Activity</div>
<table class="index">
  <tbody>
    {% assign news_items = site.news | reverse %}
    {% if page.announcements.limit %}
      {% assign news_limit = page.announcements.limit %}
    {% else %}
      {% assign news_limit = news_items.size %}
    {% endif %}
    {% for item in news_items limit: news_limit %}
    <tr>
      <td class="date">{{ item.date | date: '%b %d, %Y' }}</td>
      <td>
        {% if item.inline %}
          {{ item.content | remove: '<p>' | remove: '</p>' }}
        {% else %}
          <a href="{{ item.url | relative_url }}">{{ item.title }}</a>
        {% endif %}
      </td>
    </tr>
    {% endfor %}
  </tbody>
</table>
{% endif %}

{% if page.latest_posts.enabled or page.selected_papers %}
<div class="about-posts-grid">
  {% if page.latest_posts and page.latest_posts.enabled %}
  <div>
    <div class="section-label">3 &middot; Latest Correspondence</div>
    <h2 class="sec">From the blog</h2>
    <table class="index">
      <tbody>
        {% assign posts = site.posts %}
        {% if page.latest_posts.limit %}{% assign posts_limit = page.latest_posts.limit %}{% else %}{% assign posts_limit = 5 %}{% endif %}
        {% for post in posts limit: posts_limit %}
        <tr>
          <td class="date">{{ post.date | date: '%b %d, %Y' }}</td>
          <td><a href="{{ post.url | relative_url }}">{{ post.title }}</a></td>
        </tr>
        {% endfor %}
      </tbody>
    </table>
  </div>
  {% endif %}

  {% if page.selected_papers %}
  <div>
    <div class="section-label">4 &middot; Selected Publications</div>
    <h2 class="sec">Recent work</h2>
    {% bibliography --query @*[selected=true] --group_by none %}
  </div>
  {% endif %}
</div>
{% endif %}

{% if page.social %}
<hr class="rule-heavy" />
<div class="section-label">5 &middot; Correspondence</div>
<div class="about-social-grid">
  <div>
    <div class="mono" style="font-size:10.5px;letter-spacing:0.14em;text-transform:uppercase;color:var(--ink-3);margin-bottom:6px">Mail</div>
    {% include social.liquid %}
    <p class="small muted" style="margin-top:4px">{{ site.contact_note }}</p>
  </div>
  <div>
    <div class="mono" style="font-size:10.5px;letter-spacing:0.14em;text-transform:uppercase;color:var(--ink-3);margin-bottom:6px">Address</div>
    IMT Atlantique<br/>
    4 Rue Alfred Kastler<br/>
    44300 Nantes, France
  </div>
</div>
{% endif %}
