<header class="masthead">
  <a class="brand plain" href="{{ '/' | relative_url }}">
    <small>Journal of Energy-Aware Computing</small>
    MENRA &middot; W &middot; ROMIAL
  </a>
  <nav>
    {%- assign sorted_pages = site.pages | sort: 'nav_order' -%}
    {%- for p in sorted_pages -%}
      {%- if p.nav and p.autogen == null -%}
        {%- assign parent_link = p.permalink | remove: 'index.html' -%}
        {%- assign is_active = false -%}
        {%- if page.url == p.url or page.url contains parent_link -%}
          {%- assign is_active = true -%}
        {%- endif -%}
        <a href="{{ p.url | relative_url }}" class="plain{% if is_active %} active{% endif %}">{{ p.title }}</a>
      {%- endif -%}
    {%- endfor -%}
  </nav>
  <div class="tools">
    <button class="kbd" data-theme-btn onclick="__toggleTheme()">☼ paper</button>
    <button class="kbd" onclick="__openCmd ? __openCmd() : null">⌘ K</button>
  </div>
</header>
<div class="issue-bar">
  <span>Vol. III &mdash; No. 2</span>
  <span>ISSN 2026 &middot; 0442 &mdash; Open Access</span>
  <span>Nantes &middot; {{ site.time | date: '%B %Y' }}</span>
</div>
