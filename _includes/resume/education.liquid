{% assign education = data[1] | sort: 'startDate' | reverse %}
{% for content in education %}
<div class="cv-row">
  <div class="when">
    {% if content.startDate %}{{ content.startDate | slice: 0, 4 }}{% endif %}
    {% if content.endDate %}&ndash; {{ content.endDate | slice: 0, 4 }}{% elsif content.startDate %}&ndash; present{% endif %}
  </div>
  <div>
    <h4>{{ content.studyType }}{% if content.area %} &middot; {{ content.area }}{% endif %}</h4>
    <div class="inst">{{ content.institution }}{% if content.location %} &middot; {{ content.location }}{% endif %}</div>
    {% if content.score %}<p>{{ content.score }}</p>{% endif %}
    {% if content.courses.size > 0 %}
    <ul class="cv-items">{% for item in content.courses %}<li>{{ item }}</li>{% endfor %}</ul>
    {% endif %}
  </div>
</div>
{% endfor %}
