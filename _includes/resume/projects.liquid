{% assign projects = data[1] | sort: 'startDate' | reverse %}
{% for content in projects %}
<div class="cv-row">
  <div class="when">
    {% if content.startDate %}{{ content.startDate | slice: 0, 4 }}{% endif %}
    {% if content.endDate %}&ndash; {{ content.endDate | slice: 0, 4 }}{% elsif content.startDate %}&ndash; present{% endif %}
  </div>
  <div>
    <h4>{% if content.url %}<a href="{{ content.url }}">{{ content.name }}</a>{% else %}{{ content.name }}{% endif %}</h4>
    {% if content.description %}<p>{{ content.description }}</p>{% endif %}
    {% if content.highlights.size > 0 %}
    <ul class="cv-items">{% for item in content.highlights %}<li>{{ item }}</li>{% endfor %}</ul>
    {% endif %}
  </div>
</div>
{% endfor %}
