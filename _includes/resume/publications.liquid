{% assign publications = data[1] | sort: 'releaseDate' | reverse %}
{% for content in publications %}
<div class="cv-row">
  <div class="when">{{ content.releaseDate | slice: 0, 4 }}</div>
  <div>
    <h4>{% if content.url %}<a href="{{ content.url }}">{{ content.name }}</a>{% else %}{{ content.name }}{% endif %}</h4>
    {% if content.publisher %}<div class="inst">{{ content.publisher }}</div>{% endif %}
    {% if content.summary %}<p>{{ content.summary }}</p>{% endif %}
  </div>
</div>
{% endfor %}
