{% assign certificates = data[1] | sort: 'date' | reverse %}
{% for content in certificates %}
<div class="cv-row">
  <div class="when">{{ content.date | slice: 0, 4 }}</div>
  <div>
    <h4>{% if content.url %}<a href="{{ content.url }}">{{ content.name }}</a>{% else %}{{ content.name }}{% endif %}</h4>
    {% if content.issuer %}<div class="inst">{{ content.issuer }}</div>{% endif %}
  </div>
</div>
{% endfor %}
