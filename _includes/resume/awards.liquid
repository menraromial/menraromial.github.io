{% for content in data[1] %}
<div class="cv-row">
  <div class="when">{{ content.date | slice: 0, 4 }}</div>
  <div>
    <h4>{% if content.url %}<a href="{{ content.url }}">{{ content.title }}</a>{% else %}{{ content.title }}{% endif %}</h4>
    {% if content.awarder %}<div class="inst">{{ content.awarder }}</div>{% endif %}
    {% if content.summary %}<p>{{ content.summary }}</p>{% endif %}
  </div>
</div>
{% endfor %}
