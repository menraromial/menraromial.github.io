{% assign volunteer = data[1] | sort: 'startDate' | reverse %}
{% for content in volunteer %}
<div class="cv-row">
  <div class="when">
    {% if content.startDate %}{{ content.startDate | slice: 0, 4 }}{% endif %}
    {% if content.endDate %}&ndash; {{ content.endDate | slice: 0, 4 }}{% elsif content.startDate %}&ndash; present{% endif %}
  </div>
  <div>
    <h4>{{ content.position }}</h4>
    <div class="inst">{{ content.organization }}{% if content.location %} &middot; {{ content.location }}{% endif %}</div>
    {% if content.summary %}<p>{{ content.summary }}</p>{% endif %}
    {% if content.highlights.size > 0 %}
    <ul class="cv-items">{% for item in content.highlights %}<li>{{ item }}</li>{% endfor %}</ul>
    {% endif %}
  </div>
</div>
{% endfor %}
